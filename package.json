{
  "name": "gametab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "split": "node tools/split.mjs",
    "verify": "node tools/split.mjs --verify",
    "public": "node web/scripts/copy-public.mjs",
    "dev": "npm run public && vite --config web/vite.config.js",
    "build": "npm run public && vite build --config web/vite.config.js",
    "lint": "eslint --config web/eslint.config.js web/src"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@babel/traverse": "7.29.10",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3"
  }
}
