{
  "name": "gametab",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "split": "node tools/split.mjs",
    "verify": "node tools/split.mjs --verify",
    "public": "node web/scripts/copy-public.mjs",
    "dev": "npm run public && vite --config web/vite.config.mjs",
    "build": "npm run public && vite build --config web/vite.config.mjs",
    "lint": "eslint --config web/eslint.config.mjs web/src"
  },
  "dependencies": {
    "motion": "14.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/generator": "7.29.8",
    "@babel/parser": "7.29.9",
    "@babel/traverse": "7.29.10",
    "@babel/types": "7.29.11",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4"
  }
}
